_site
.bundle

# ─── Block heavy media globally ───
*.mp4
# AI prototype media is intentional site content; allow future prototype folders too.
!assets/media/ai-prototypes/**/*.mp4

# CAPTCHA: After Human ships its opener as media inside the built app rather
# than as page assets -- a GLB logo, an alpha-channel hologram, a video plate
# and a sound cue. The *.mp4 / *.webm / *.glb rules above would leave all four
# on this machine and on no other, which is a prototype that works locally and
# is broken the moment anyone else opens it.
!ai-prototypes/captcha/opener/*.mp4
!assets/img/fairview/specialty-icons.mp4
# Case-study demo clips. These are referenced by the Marriott and M Health
# Fairview pages and are small (128K-356K, 1.5MB for all six). The blanket
# *.mp4 above meant they existed on every machine that made them and on no
# deploy: the pages worked locally and shipped six broken <video> elements to
# production, which is what the link checker had been failing on.
!assets/img/marriott/04-overview.mp4
!assets/img/marriott/05-flow.mp4
!assets/img/marriott/06-enroll.mp4
!assets/img/marriott/08-enrollmodal.mp4
!assets/img/fairview/07-choose.mp4
!assets/img/fairview/11-assistant.mp4
*.mov
*.avi
*.mkv
*.webm
*.glb
*.gltf
*.fbx
*.zip
*.tar.gz

# ─── Block assets/video by default, allow specific homepage/loader files ───
assets/video/*
!assets/video/cube_gettingup.mp4
# The -web encodes are the ones the loader actually plays. Neither was on this
# list, so the opening sequence referenced two files that existed on this
# machine and on no deploy — the same failure that shipped six broken <video>
# elements on the case studies for months.
!assets/video/cube_gettingup-web.mp4
!assets/video/loading-ani-web.mp4
!assets/video/loading-ani.mp4
!assets/video/sid_intro.mp4
!assets/video/sid_pixelated.mp4
!assets/video/sid_sitting.mp4
!assets/video/sid_rooftop_4k.mp4
!assets/video/sid_rooftop_depth.mp4
!assets/video/cube_footer.mp4
# ─── Play page scatter clips ───
!assets/video/play/
!assets/video/play/*.mp4
# The twelve short clips beside their own .jpg posters. The posters were
# tracked and the clips were not, so every one of them was a 404 on the
# deployed site while looking perfectly fine on the machine that made them —
# the same trap the note above this block describes.
!play/assets/video/
!play/assets/video/*.mp4

# ─── Allow 3D models in assets/models for the Enter scene floating sculpture ───
!assets/models/*.glb

# ─── Allow video/mov inside project asset folders ───
!1.met/**/*.mp4
!1.met/**/*.mov
# Specific re-ignore — webby.mov is a 72MB local-only file, not for the site
1.met/webby.mov
!2.cube/**/*.mp4
!2.cube/**/*.mov
!2.ai-self/**/*.mp4
!4.mandala/**/*.mp4
!4.mandala/**/*.mov
!5.bb/**/*.mp4
!5.mool/**/*.mp4
!6.mindu/**/*.mp4
!7.naavo/**/*.mp4
!8.shotoniphone/**/*.mp4
!9.aananda/**/*.mp4
!10.alpha/**/*.mp4
!11.illu/**/*.mp4
!15.bloom-vp/**/*.mp4

# ─── Allow play page assets (videos in masonry + spiral hero) ───
!play/assets/*.mp4
!play/assets/*.gif

# ─── Standard ignores ───
.DS_Store
.idea
.jekyll-cache
.jekyll-metadata
.ruby-version
.sass-cache
.tweet-cache
.venv
assets/libs/
assets/rendercv/rendercv_output/*.typ
Gemfile.lock
node_modules/
vendor2.cube/

# ─── Local QA artifacts from visual review passes ───
.playwright-cli/
.qa-final-*/
WEBSITE_NEXT_LEVEL_AUDIT.md
*-desktop.png
*-motion-qa.png
*-case-map.png
*-recruiter-flow.png
*-mobile-recruiter-flow.png
shared-*.png
assets/img/play-memory-wall.png

# scratch and staging dirs kept out of the repo
_scratch/
_to_delete/
_to_delete_*
.fuse_hidden*

# The other two halves of the CAPTCHA opener. Kept down here rather than with
# the .mp4 negation above because *.webm and *.glb are declared further down
# this file, and gitignore is last-match-wins -- a negation placed above the
# rule it negates silently does nothing.
!ai-prototypes/captcha/opener/*.webm
!ai-prototypes/captcha/opener/*.glb
.qa/

# The Buddha point cloud is a build product of _scripts/extract_buddha_points.mjs,
# but it is 502KB and the source GLB is meshopt-compressed, so regenerating it
# needs a decoder fetched from a CDN. Shipped rather than rebuilt on deploy.
!assets/models/buddha-points.bin
!assets/models/form-tree.bin
!assets/models/form-brain.bin
