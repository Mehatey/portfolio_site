.playwright-cli/
.qa-final-*/
WEBSITE_NEXT_LEVEL_AUDIT.md
*-desktop.png
*-motion-qa.png
*-case-map.png
*-recruiter-flow.png
*-mobile-recruiter-flow.png
shared-*.png
assets/img/play-memory-wall.png

# scratch and staging dirs kept out of the repo
_scratch/
_to_delete/
_to_delete_*
.fuse_hidden*
