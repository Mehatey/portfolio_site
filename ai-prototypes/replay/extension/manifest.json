{
  "manifest_version": 3,
  "name": "Replay · Keyboard Evidence",
  "version": "0.1.0",
  "description": "Record navigation keys and focus transitions as local accessibility evidence.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Open Replay" },
  "side_panel": { "default_path": "sidepanel.html" }
}
